FLASK_ENV=production
IMAGE_TAG=latest
WEB_CONCURRENCY=3
GHCR_OWNER=yonca-sdc
SECRET_KEY=change-me

# Database
POSTGRES_DB=yonca_db
POSTGRES_USER=yonca_user
POSTGRES_PASSWORD=changeme
# 5438=staging, 5439=prod (set automatically by deploy.yml)
POSTGRES_PORT=5432

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LibreTranslate (set when running outside Docker, e.g. just dev)
LIBRETRANSLATE_URL=http://localhost:5050

# Caddy reverse proxy
DOMAIN=yonca-sdc.com
LOCAL_DOMAIN=local.yonca-sdc.com
APP_HOSTNAME=local-yonca-sdc-com
APP_PORT=3000
