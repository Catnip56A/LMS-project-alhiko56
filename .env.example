FLASK_ENV=production
IMAGE_TAG=latest
WEB_CONCURRENCY=3
GHCR_OWNER=
SECRET_KEY=change-me

# Database
POSTGRES_DB=lms_db
POSTGRES_USER=lms_user
POSTGRES_PASSWORD=changeme
# 5438=staging, 5439=prod (set automatically by deploy.yml)
POSTGRES_PORT=5432
REDIS_PORT=6379

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# DeepL (translation pipeline) — https://www.deepl.com/pro-api, free tier
DEEPL_API_KEY=

# Cloudflare R2 (course content object storage) — https://dash.cloudflare.com/ , free tier 10GB + zero egress
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Optional: how long a media presigned URL stays valid (seconds, default 21600 = 6h)
R2_URL_EXPIRY_SECONDS=21600
# Dev only: read-only token scoped to the production bucket, so content pulled in via
# `just db-pull-staging`/production plays locally even before it's re-uploaded to the dev bucket
R2_UPSTREAM_ACCOUNT_ID=
R2_UPSTREAM_ACCESS_KEY_ID=
R2_UPSTREAM_SECRET_ACCESS_KEY=
R2_UPSTREAM_BUCKET_NAME=
# Optional: Cloudflare Worker fronting R2 with short-lived signed URLs instead of long-lived
# presigned ones — see workers/file-proxy/README.md to deploy. If unset, falls back to plain
# presigned URLs (still private, just valid for R2_URL_EXPIRY_SECONDS instead of ~60s).
R2_WORKER_URL=
R2_WORKER_SIGNING_SECRET=
# Cloudflare API token (Account > Workers Scripts > Edit, Account > Workers R2 Storage > Edit)
# + account ID — only needed to run `just deploy-worker` (redeploys workers/file-proxy/ without
# manually exporting these every time). Not needed for the app itself to run.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Caddy reverse proxy
DOMAIN=yourdomain.example.com
LOCAL_DOMAIN=local.yourdomain.example.com
APP_HOSTNAME=local-yourdomain-example-com
APP_PORT=3000
